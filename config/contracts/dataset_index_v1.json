    "required_topics_known_policy_topics_only": true,
    "required_topics_unique_absolute_names": true,
    "required_static_edges_v1": "empty_only",
    "unknown_fields": "reject"
  },
  "cli_errors": {
    "normalized_types": ["DatasetIndexError", "ValueError", "TypeError", "OSError"],
    "json_summary_failure_status": "indexer_failed",
    "failure_exit_code": 2
  },
  "deferred": ["sample_index.jsonl", "training_manifest.jsonl", "image_decode_export", "image_compression", "topic_downsampling", "sample_pairing", "action_interpolation", "execution_feedback_window_pairing", "tf_frame_graph_reconstruction", "train_split"]
